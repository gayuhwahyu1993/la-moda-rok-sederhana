rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // =========================================================================
    // 1. EXISTING LA MODA APPLICATION RULES (PRESERVED EXACTLY AS DEPLOYED)
    // =========================================================================
    match /course_thumbnails/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == 'InD6Ckc1ALXjhTJ7xR0SvnzQ1hZ2';
    }

    // =========================================================================
    // 2. NEW LA MODA CALCULATOR IMAGES SYSTEM
    // =========================================================================
    match /calculators/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'DCxRooMyGBMJDCde6TLQ3vE4c2k1';
    }

  }
}
